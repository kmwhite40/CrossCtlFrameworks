.DS_Store
*.xlsx
__pycache__/
*.pyc
.venv/
.env
.env.*
!.env.example
data/*
# Ship the NIST catalog workbook with the repo so `ccf ingest` works on any clone.
!data/NIST Cross Mappings Rev. 1.1.xlsx
# Ship the pinned OSCAL 800-53r5 catalog + baselines so the verifying loader
# works on any clone without a network fetch at runtime.
!data/oscal/
!data/oscal/*
# Ship the DISA CCI list and the Rev. 5 CCI mapping workbook so the CCI
# ingest works on any clone. The HTML is DISA's published CCI List (the
# authority); the .ods is a derived Rev. 5 mapping carrying AP acronyms and
# eMASS identifiers.
!data/cci/
!data/cci/*
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
sbom.json
.coverage
htmlcov/

# Local skill data caches (not project code)
.claude/skills/*/data/
