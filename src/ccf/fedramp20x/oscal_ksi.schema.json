{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concord.local/schemas/fedramp20x-oscal-ksi.schema.json",
  "title": "Concord FedRAMP 20x OSCAL assessment-results subset",
  "description": "A Concord-maintained JSON Schema covering the subset of OSCAL assessment-results that ccf.fedramp20x.package.to_oscal_shaped emits. It is NOT the official OSCAL schema and does not assert full OSCAL conformance; it enforces the structure Concord produces so downstream consumers get a stable contract.",
  "type": "object",
  "required": ["assessment-results"],
  "additionalProperties": true,
  "properties": {
    "assessment-results": {
      "type": "object",
      "required": ["uuid", "metadata", "results"],
      "additionalProperties": true,
      "properties": {
        "uuid": {"type": "string", "minLength": 1},
        "metadata": {
          "type": "object",
          "required": ["title", "last-modified", "oscal-version"],
          "additionalProperties": true,
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "last-modified": {"type": "string", "minLength": 1},
            "oscal-version": {"type": "string", "minLength": 1},
            "remarks": {"type": "string"}
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["uuid", "title"],
            "additionalProperties": true,
            "properties": {
              "uuid": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "props": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "value"],
                  "properties": {
                    "name": {"type": "string"},
                    "value": {"type": "string"}
                  }
                }
              },
              "observations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["uuid", "title"],
                  "additionalProperties": true,
                  "properties": {
                    "uuid": {"type": "string", "minLength": 1},
                    "title": {"type": "string", "minLength": 1}
                  }
                }
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["uuid", "title", "target"],
                  "additionalProperties": true,
                  "properties": {
                    "uuid": {"type": "string", "minLength": 1},
                    "title": {"type": "string", "minLength": 1},
                    "target": {"type": "object"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
