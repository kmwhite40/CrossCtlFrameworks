      "rule": {"kind": "any_of", "rules": [
        {"kind": "connector_capture", "captures": ["mfa_enforced"]},
        {"kind": "control_state", "controls": ["IA-2"], "states": ["implemented", "inherited"]}
      ]},
      "validation_method": "automated", "validation_frequency": "continuous",
      "automation_level": "automated"
    },
    "KSI-MLA-OSM": {
