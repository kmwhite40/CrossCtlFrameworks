      ]},
      "validation_method": "automated", "validation_frequency": "continuous",
      "automation_level": "automated"
    },
    "KSI-SVC-SIN": {
      "rule": {"kind": "any_of", "rules": [
        {"kind": "connector_capture", "captures": ["encryption_at_rest"]},
        {"kind": "control_state", "controls": ["SC-28"], "states": ["implemented", "inherited"]}
      ]},
      "validation_method": "automated", "validation_frequency": "continuous",
