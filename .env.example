# CrossCtlFrameworks — Copyright © 2026 Colleen Townsend
CCF_DATABASE_URL=postgresql+asyncpg://ccf:ccf@localhost:5432/ccf
CCF_DATABASE_URL_SYNC=postgresql+psycopg://ccf:ccf@localhost:5432/ccf
CCF_LOG_LEVEL=INFO
CCF_LOG_JSON=false
CCF_API_HOST=0.0.0.0
CCF_API_PORT=8000
CCF_WORKBOOK_PATH=./data/NIST Cross Mappings Rev. 1.1.xlsx

# --- Official OSCAL schema validation (optional) ---------------------------
# Point at a directory holding the upstream NIST OSCAL JSON Schemas
# (oscal_ssp_schema.json, oscal_component_schema.json, oscal_poam_schema.json, …)
# to validate exports against the official schema. Left unset, Concord falls back
# to built-in structural checks and reports a degraded reliability status.
# CCF_OSCAL_SCHEMA_DIR=./schemas/oscal
CCF_OSCAL_REQUIRE_OFFICIAL_SCHEMA=false

# --- Enterprise SSO: OIDC + SCIM (optional, disabled by default) -----------
# With OIDC off, Concord uses local session login (dev needs no IdP).
CCF_OIDC_ENABLED=false
# CCF_OIDC_ISSUER=https://login.example.com
# CCF_OIDC_CLIENT_ID=concord
# CCF_OIDC_CLIENT_SECRET=change-me
# CCF_OIDC_REDIRECT_URI=https://concord.example.gov/auth/callback
# CCF_OIDC_ALLOWED_DOMAINS=["example.gov"]
CCF_AUTH_JIT_PROVISIONING=true
CCF_SCIM_ENABLED=false
# CCF_SCIM_BEARER_TOKEN=generate-a-long-random-token
