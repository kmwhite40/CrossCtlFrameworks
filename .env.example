# CrossCtlFrameworks — Copyright © 2026 Colleen Townsend
CCF_DATABASE_URL=postgresql+asyncpg://ccf:ccf@localhost:5432/ccf
CCF_DATABASE_URL_SYNC=postgresql+psycopg://ccf:ccf@localhost:5432/ccf
CCF_LOG_LEVEL=INFO
CCF_LOG_JSON=false
CCF_API_HOST=0.0.0.0
CCF_API_PORT=8000
CCF_WORKBOOK_PATH=./data/NIST Cross Mappings Rev. 1.1.xlsx

# --- Production: the application REFUSES TO START without these ------------
# `enforce_secure_config` raises on start in any non-development environment
# if auth is off, the session secret is the default, or CORS is wildcard.
CCF_ENV=dev
CCF_AUTH_ENABLED=false
# CCF_AUTH_SESSION_SECRET=generate-32-plus-random-bytes
# CCF_API_CORS_ORIGINS=["https://concord.example.gov"]

# --- Production: NOT enforced on start, and just as necessary --------------
# Wraps every stored connector, AI provider and MFA secret. Without it the
# cipher fails closed and NO credential can be saved at all -- which presents
# as "the connector page will not accept my key". With the wrong one, existing
# credentials are unreadable.
#
# Changing it in place destroys access to everything already stored. Rotate
# with docs/runbooks/credential-key-rotation.md, which keeps the outgoing key
# in CCF_AI_CREDENTIAL_PREVIOUS_KEYS until the rewrap sweep reports clean.
#
# Back it up separately from the database: a dump restored without its key
# comes back with every credential unreadable.
# CCF_AI_CREDENTIAL_MASTER_KEY=generate-32-plus-random-bytes
# CCF_AI_CREDENTIAL_PREVIOUS_KEYS=["the-key-being-rotated-out"]
#
# `local` keeps key material in the environment. Production should not.
CCF_AI_CREDENTIAL_KEY_PROVIDER=local

# --- Outbound / proxy ------------------------------------------------------
# Only if a separately-hosted front end posts to this API. A reverse proxy that
# rewrites Host makes every state-changing request fail the CSRF origin check;
# name the public origin here rather than relaxing the check.
# CCF_CSRF_TRUSTED_ORIGINS=["https://app.example.gov"]

# --- Official OSCAL schema validation (optional) ---------------------------
# Point at a directory holding the upstream NIST OSCAL JSON Schemas
# (oscal_ssp_schema.json, oscal_component_schema.json, oscal_poam_schema.json, …)
# to validate exports against the official schema. Left unset, Concord falls back
# to built-in structural checks and reports a degraded reliability status.
# CCF_OSCAL_SCHEMA_DIR=./schemas/oscal
CCF_OSCAL_REQUIRE_OFFICIAL_SCHEMA=false

# --- Enterprise SSO: OIDC + SCIM (optional, disabled by default) -----------
# With OIDC off, Concord uses local session login (dev needs no IdP).
CCF_OIDC_ENABLED=false
# CCF_OIDC_ISSUER=https://login.example.com
# CCF_OIDC_CLIENT_ID=concord
# CCF_OIDC_CLIENT_SECRET=change-me
# CCF_OIDC_REDIRECT_URI=https://concord.example.gov/auth/callback
# CCF_OIDC_ALLOWED_DOMAINS=["example.gov"]
CCF_AUTH_JIT_PROVISIONING=true
CCF_SCIM_ENABLED=false
# CCF_SCIM_BEARER_TOKEN=generate-a-long-random-token

# --- Evidence repository ---------------------------------------------------
# Versioned, content-addressed evidence. Local filesystem by default (no deps);
# set backend=s3 with a bucket to use an S3-compatible / object-locked (WORM)
# store via boto3 when installed (degrades to local otherwise).
CCF_EVIDENCE_BACKEND=local
CCF_EVIDENCE_LOCAL_DIR=./data/evidence
# CCF_EVIDENCE_S3_BUCKET=concord-evidence
CCF_EVIDENCE_OBJECT_LOCK_ENABLED=false

# --- Typed AI GRC actions (optional, disabled by default) ------------------
# With AI off, actions run against a deterministic, citation-first stub (safe for
# local/dev + tests). AI never mutates an authoritative record without approval.
CCF_AI_ENABLED=false
CCF_AI_PROVIDER=stub
# CCF_AI_MODEL=claude-sonnet-5
CCF_AI_REQUIRE_HUMAN_APPROVAL=true
CCF_AI_ALLOW_UNCITED_DRAFTS=false
